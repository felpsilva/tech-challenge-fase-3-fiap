# ---------------------------------------------------------------------------
# Configuracao compartilhada por backend e frontend.
#
# Este arquivo fica na RAIZ de proposito: os dois pacotes leem daqui, entao a
# URL da API e as credenciais do banco existem em um lugar so. Cada pacote sobe
# a arvore de diretorios ate achar este arquivo (ver `load-env-files.ts` no
# backend e `load-root-env.ts` no frontend).
#
# Precedencia: variavel ja exportada no ambiente > .env.<NODE_ENV> > .env.
# Por isso o docker compose e o CI conseguem sobrescrever qualquer valor daqui
# sem editar o arquivo.
#
# Este arquivo E versionado (decisao do time, projeto academico). Nao coloque
# aqui nada que nao possa ir para o repositorio.
# ---------------------------------------------------------------------------

# --- Backend (API Fastify) ---
PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://neondb_owner:npg_snvKoPbRk6E3@ep-frosty-hall-atwf1mkx-pooler.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DB_HOST=ep-frosty-hall-atwf1mkx-pooler.c-9.us-east-1.aws.neon.tech
DB_PORT=5432
DB_USERNAME=blog-user
DB_PASSWORD=blog123321
DB_NAME=blog-educacional
JWT_SECRET=itachi
# Origens liberadas no CORS (lista separada por virgula).
CORS_ORIGIN=http://localhost:3000

# --- Frontend (Next.js) ---
# URL da API acessada pelo NAVEGADOR (axios e o <img> da thumbnail). E embutida
# no bundle em tempo de BUILD — trocar em runtime nao tem efeito.
NEXT_PUBLIC_API_URL=http://localhost:3001
# URL da API acessada pelo SERVIDOR do Next (Server Components). Dentro do
# docker compose aponta para o nome do servico, nao para localhost.
API_URL=http://localhost:3001
