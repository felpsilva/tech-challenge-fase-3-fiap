# ---------------------------------------------------------------------------
# Modelo do arquivo `.env` da raiz, compartilhado por backend e frontend.
# Copie para `.env` e preencha. Para producao, use `.env.production` com apenas
# as chaves que mudam.
# ---------------------------------------------------------------------------

# --- Backend (API Fastify) ---
PORT=
NODE_ENV=
DATABASE_URL=
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
JWT_SECRET=
# Lista separada por virgula com as origens liberadas no CORS.
CORS_ORIGIN=

# --- Frontend (Next.js) ---
# Lida pelo NAVEGADOR; embutida no bundle em tempo de build.
NEXT_PUBLIC_API_URL=
# Lida pelo SERVIDOR do Next (Server Components); no compose aponta para o
# nome do servico do backend.
API_URL=
