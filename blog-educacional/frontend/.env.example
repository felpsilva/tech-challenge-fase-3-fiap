# URL da API acessada pelo NAVEGADOR (axios e o <img> da thumbnail).
# É embutida no bundle em tempo de BUILD — trocar em runtime nao tem efeito.
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL da API acessada pelo SERVIDOR do Next (Server Components). Dentro do
# docker compose aponta para o nome do servico, nao para localhost.
API_URL=http://localhost:3001
